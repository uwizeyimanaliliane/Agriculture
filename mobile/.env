# Google Sign-In (REQUIRED for "Sign in with Google" button to appear)
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
#
# 1. Create a project (or select existing)
# 2. Go to APIs & Services > Credentials
# 3. Click "Create Credentials" > "OAuth client ID"
# 4. For Expo Go: choose "Web application", add "https://auth.expo.io/@YOUR_EXPO_USERNAME/agrilink" to authorized redirect URIs
# 5. Copy the Client ID and paste below
# 6. For Android: create "Android" OAuth client with your app's package name and SHA-1
#
# Expo Go only needs the Web client ID:
EXPO_PUBLIC_GOOGLE_CLIENT_ID=827251390032-lf1eq7qbb8jhio2s00b6nif03rkgu8qh.apps.googleusercontent.com
# Android client ID: required when running on a real Android device or standalone Android build.
# If you don't have a separate Android client ID yet, the web client ID will be used as a fallback.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS client (optional, for iOS builds):
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
